     Core *ScreenGrab = Core::instance();
     ScreenGrab->processCmdLineOpts(scr.arguments());
+    // DoroShell import is independent of any ScreenGrab instance taking a new shot.
+    if (scr.arguments().contains(QStringLiteral("--import-png")))
+    {
+        QFile input;
+        constexpr qint64 limit = 256LL * 1024 * 1024;
+        if (!input.open(stdin, QIODevice::ReadOnly))
+            return 1;
+        const QByteArray png = input.read(limit + 1);
+        if (png.size() > limit || !ScreenGrab->getPixmap()->loadFromData(png, "PNG"))
+            return 1;
+        ScreenGrab->modules()->initModules();
+        ScreenGrab->initWindow();
+        std::puts("IMPORTED");
+        std::fflush(stdout);
+        return scr.exec();
