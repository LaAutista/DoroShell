+    mList->setCurrentRow(0);
+    auto row = new QHBoxLayout;
+    auto add = new QPushButton(tr("Add application…"), this);
+    auto remove = new QPushButton(tr("Remove"), this);
+    auto up = new QPushButton(tr("Move up"), this);
+    auto down = new QPushButton(tr("Move down"), this);
+    add->setObjectName(QStringLiteral("addPin"));
+    remove->setObjectName(QStringLiteral("removePin"));
+    up->setObjectName(QStringLiteral("movePinUp"));
+    down->setObjectName(QStringLiteral("movePinDown"));
+    for (auto button : {add, remove, up, down}) row->addWidget(button);
+    layout->addLayout(row);
+    connect(add, &QPushButton::clicked, this, [this] {
+        const auto files = QFileDialog::getOpenFileNames(this, tr("Choose applications"),
+            QStandardPaths::locate(QStandardPaths::GenericDataLocation, QStringLiteral("applications"), QStandardPaths::LocateDirectory),
+            tr("Desktop entries (*.desktop)"), nullptr, QFileDialog::DontUseNativeDialog);
+        for (const auto &path : files) if (!this->paths().contains(path)) addPath(path);
+    });
+    connect(remove, &QPushButton::clicked, this, [this] { delete mList->takeItem(mList->currentRow()); });
+    connect(up, &QPushButton::clicked, this, [this] { moveCurrent(-1); });
+    connect(down, &QPushButton::clicked, this, [this] { moveCurrent(1); });
+    auto buttons = new QDialogButtonBox(QDialogButtonBox::Save | QDialogButtonBox::Cancel, this);
+    buttons->setObjectName(QStringLiteral("pinEditorButtons"));
+    layout->addWidget(buttons);
+    connect(buttons, &QDialogButtonBox::accepted, this, &DoroShellPinsDialog::accept);
+    connect(buttons, &QDialogButtonBox::rejected, this, &QDialog::reject);
+}
+
+void DoroShellPinsDialog::addPath(const QString &path)
+{
+    XdgDesktopFile entry;
+    const bool valid = entry.load(path);
+    auto item = new QListWidgetItem(valid ? XdgIcon::fromTheme(entry.value(QStringLiteral("Icon")).toString()) : QIcon(),
+        valid ? entry.name() : tr("Unavailable: %1").arg(QFileInfo(path).fileName()), mList);
+    item->setData(Qt::UserRole, path);
+    item->setToolTip(path);
+}
+
+QStringList DoroShellPinsDialog::paths() const
+{
+    QStringList result;
+    for (int i = 0; i < mList->count(); ++i) result << mList->item(i)->data(Qt::UserRole).toString();
+    return result;
+}
+
+void DoroShellPinsDialog::moveCurrent(int delta)
+{
+    const int from = mList->currentRow(), to = from + delta;
+    if (from < 0 || to < 0 || to >= mList->count()) return;
+    auto item = mList->takeItem(from);
+    mList->insertItem(to, item);
+    mList->setCurrentRow(to);
+}
+
+void DoroShellPinsDialog::accept()
+{
+    QSet<QString> identities;
+    for (const auto &path : paths())
+    {
+        XdgDesktopFile entry;
+        if (!QFileInfo(path).isAbsolute() || !QFileInfo(path).isFile() || !entry.load(path)
+            || entry.value(QStringLiteral("Type")).toString() != QStringLiteral("Application"))
+        {
+            QMessageBox::warning(this, tr("Cannot save pins"), tr("Remove or replace this unavailable application:\n%1").arg(path));
+            return;
+        }
+        QString identity = entry.value(QStringLiteral("StartupWMClass")).toString();
+        if (identity.isEmpty()) identity = QFileInfo(path).completeBaseName();
+        identity = identity.toCaseFolded();
+        if (identities.contains(identity))
+        {
+            QMessageBox::warning(this, tr("Cannot save pins"), tr("Two entries use the same application identity: %1").arg(identity));
+            return;
+        }
+        identities.insert(identity);
+    }
+    QDialog::accept();
+}
