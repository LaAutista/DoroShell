+
+bool LXQtTaskBar::pinDrop(const QMimeData* data)
+{
+    const QStringList paths = launcherDropPaths(data);
+    if (paths.isEmpty()) return false;
+    const QStringList original = mPinnedPaths;
+    // Rebuilding task buttons must happen after the drag/drop event returns.
+    QTimer::singleShot(0, this, [this, paths, original] {
+        auto settings = mPlugin->settings();
+        settings->syncKeepingResetState();
+        if (settings->value(QStringLiteral("doroshellPinned")).toStringList() != original)
+        {
+            QMessageBox::warning(this, tr("Taskbar pins changed"), tr("Try the drop again after the other pin changes finish."));
+            return;
+        }
+        QStringList updated = original;
+        for (const QString& path : paths)
+            if (!updated.contains(path)) updated.append(path);
+        if (updated == original) return;
+        settings->setValue(QStringLiteral("doroshellPinned"), updated);
+        settings->syncKeepingResetState();
+    });
+    return true;
+}
+
