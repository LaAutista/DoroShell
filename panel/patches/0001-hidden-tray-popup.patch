+void LXQtTaskGroup::setPinnedDesktop(const QString &path, const QString &name, const QIcon &icon)
+{
+    mPinnedDesktop = path;
+    mPinnedName = name;
+    mPinnedIcon = icon;
+    if (mButtonHash.isEmpty()) showPinnedLauncher();
+}
+
+void LXQtTaskGroup::showPinnedLauncher()
+{
+    setWindowId(0);
+    setProperty("doroshellRunning", false);
+    style()->unpolish(this); style()->polish(this);
+    mSingleButton = true;
+    setChecked(false);
+    setTextExplicitly(mPinnedName);
+    setToolTip(mPinnedName);
+    setIcon(mPinnedIcon);
+    show();
+}
+
+void LXQtTaskGroup::activatePinnedOrRaise()
+{
+    if (!mPinnedDesktop.isEmpty() && mButtonHash.isEmpty()) launchPinned();
+    else raiseApplication();
+}
+
+void LXQtTaskGroup::launchPinned()
+{
+    GDesktopAppInfo *info = g_desktop_app_info_new_from_filename(mPinnedDesktop.toUtf8().constData());
+    GError *error = nullptr;
+    bool ok = info && g_app_info_launch(G_APP_INFO(info), nullptr, nullptr, &error);
+    if (!ok) QMessageBox::warning(this, tr("Could not launch application"), error ? QString::fromUtf8(error->message) : tr("The pinned desktop entry is unavailable."));
+    if (error) g_error_free(error);
+    if (info) g_object_unref(info);
+    setChecked(false);
+}
