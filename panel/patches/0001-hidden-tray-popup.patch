+QStringList LXQtTaskBar::launcherDropPaths(const QMimeData* data) const
+{
+    if (!mGroupingEnabled || !data->hasUrls()) return {};
+    const auto urls = data->urls();
+    if (urls.isEmpty() || urls.size() > 100) return {};
+    QStringList paths;
+    for (const QUrl& url : urls)
+    {
+        if (!url.isLocalFile()) return {};
+        const QString path = url.toLocalFile();
+        if (!QFileInfo(path).isAbsolute() || !QFileInfo(path).isFile() || !path.endsWith(QStringLiteral(".desktop"))) return {};
