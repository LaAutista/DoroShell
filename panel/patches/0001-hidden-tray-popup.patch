+void LXQtTaskBar::addPinAction(QMenu* menu, WId window, const QString& pinnedPath)
+{
+    const QString identity = window ? mBackend->getWindowClass(window) : QString();
+    QString path = pinnedPath;
+    if (path.isEmpty() && mKnownWindows.contains(window)) path = mKnownWindows.value(window)->pinnedDesktop();
+    if (path.isEmpty() && !identity.isEmpty())
+    {
+        QStringList matches;
+        for (const auto& saved : mPinnedPaths)
+        {
+            XdgDesktopFile entry;
+            if (!entry.load(saved)) continue;
+            QString id = entry.value(QStringLiteral("StartupWMClass")).toString();
+            if (id.isEmpty()) id = QFileInfo(saved).completeBaseName();
+            if (id.compare(identity, Qt::CaseInsensitive) == 0) matches << saved;
+        }
+        if (matches.size() == 1) path = matches.first();
+        else if (!matches.isEmpty()) return;
+    }
+    if (path.isEmpty() && !identity.isEmpty())
+    {
+        QSet<QString> matches;
+        GList* apps = g_app_info_get_all();
+        for (GList* item = apps; item; item = item->next)
+        {
+            if (!G_IS_DESKTOP_APP_INFO(item->data) || !g_app_info_should_show(G_APP_INFO(item->data))) continue;
+            auto info = G_DESKTOP_APP_INFO(item->data);
+            const char* filename = g_desktop_app_info_get_filename(info);
+            if (!filename) continue;
+            const QString candidate = QString::fromUtf8(filename);
+            const char* wmClass = g_desktop_app_info_get_startup_wm_class(info);
+            QString id = wmClass ? QString::fromUtf8(wmClass) : QFileInfo(candidate).completeBaseName();
+            if (id.isEmpty()) id = QFileInfo(candidate).completeBaseName();
+            if (id.compare(identity, Qt::CaseInsensitive) == 0 && QFileInfo(candidate).isAbsolute()) matches.insert(candidate);
+        }
+        g_list_free_full(apps, g_object_unref);
+        if (matches.size() == 1) path = *matches.cbegin();
+    }
+    if (path.isEmpty()) return;
+    const bool pinned = mPinnedPaths.contains(path);
+    QAction* action = menu->addAction(pinned ? tr("Unpin from taskbar") : tr("Pin to taskbar"));
+    action->setObjectName(QStringLiteral("doroshellPinAction"));
+    if (!pinned && !mGroupingEnabled)
+    {
+        action->setEnabled(false);
+        action->setToolTip(tr("Enable task grouping to use unified launcher pins."));
+    }
+    const QStringList original = mPinnedPaths;
+    connect(action, &QAction::triggered, this, [this, path, pinned, original] {
+        // PluginSettings sync rebuilds buttons; wait until the menu event unwinds.
+        QTimer::singleShot(0, this, [this, path, pinned, original] {
+            auto settings = mPlugin->settings();
+            settings->syncKeepingResetState();
+            if (settings->value(QStringLiteral("doroshellPinned")).toStringList() != original)
+            {
+                QMessageBox::warning(this, tr("Taskbar pins changed"), tr("Reopen the menu after the other pin changes finish."));
+                return;
+            }
+            QStringList updated = original;
+            if (pinned) updated.removeAll(path);
+            else updated.append(path);
+            settings->setValue(QStringLiteral("doroshellPinned"), updated);
+            settings->syncKeepingResetState();
+        });
+    });
+    menu->addSeparator();
+}
+
+void LXQtTaskBar::loadPinnedLaunchers()
+{
+    if (!mGroupingEnabled) return;
+    for (const QString &path : mPinnedPaths)
+    {
+        XdgDesktopFile entry;
+        if (!QFileInfo(path).isAbsolute() || !entry.load(path) || entry.value(QStringLiteral("Type")).toString() != QStringLiteral("Application")) continue;
+        QString identity = entry.value(QStringLiteral("StartupWMClass")).toString();
+        if (identity.isEmpty()) identity = QFileInfo(path).completeBaseName();
+        auto group = createGroup(identity, 0);
+        group->setPinnedDesktop(path, entry.name(), XdgIcon::fromTheme(entry.value(QStringLiteral("Icon")).toString()));
+    }
+}
