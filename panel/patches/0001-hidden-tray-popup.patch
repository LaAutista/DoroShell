+// Keep the host buttons in place: moving them would break upstream attention,
+// registration and auto-hide handling. Popup views use the same native SNI code.
+void StatusNotifierWidget::showOverflow()
+{
+    if (mOverflow)
+    {
+        mOverflow->close();
+        return;
+    }
+    auto popup = new QFrame(this, Qt::Popup);
+    popup->setObjectName(QStringLiteral("doroshellTrayPopup"));
+    popup->setWindowTitle(tr("Hidden icons"));
+    popup->setAccessibleName(tr("Hidden notification icons"));
+    popup->setAttribute(Qt::WA_DeleteOnClose);
+    popup->setFrameShape(QFrame::StyledPanel);
+    auto grid = new QGridLayout(popup);
+    grid->setContentsMargins(8, 8, 8, 8);
+    grid->setSpacing(4);
+    int count = 0;
+    auto services = mServices.keys();
+    services.sort();
+    for (const auto &service : services)
+    {
+        auto original = mServices.value(service);
+        if (!original || original->isVisible())
+            continue;
+        const int slash = service.indexOf(QLatin1Char('/'));
+        auto button = new OverflowButton(service.left(slash), service.mid(slash), mPlugin, popup);
+        button->setAutoHide(false);
+        button->setFixedSize(36, 36);
+        button->setFocusPolicy(Qt::StrongFocus);
+        button->setAccessibleName(original->title());
+        grid->addWidget(button, count / 4, count % 4);
+        ++count;
+    }
+    if (!count)
+    {
+        delete popup;
+        return;
+    }
+    mOverflow = popup;
+    popup->ensurePolished();
+    popup->setFixedSize(popup->sizeHint());
+    auto anchor = mShowBtn->mapToGlobal(QPoint(0, 0));
+    auto bounds = mShowBtn->screen()->availableGeometry();
+    QPoint position(anchor.x(), anchor.y() - popup->height());
+    if (mPlugin->panel()->position() == ILXQtPanel::PositionTop)
+        position.setY(anchor.y() + mShowBtn->height());
+    else if (mPlugin->panel()->position() == ILXQtPanel::PositionLeft)
+        position = QPoint(anchor.x() + mShowBtn->width(), anchor.y());
+    else if (mPlugin->panel()->position() == ILXQtPanel::PositionRight)
+        position = QPoint(anchor.x() - popup->width(), anchor.y());
+    position.setX(std::clamp(position.x(), bounds.left(), std::max(bounds.left(), bounds.right() - popup->width() + 1)));
+    position.setY(std::clamp(position.y(), bounds.top(), std::max(bounds.top(), bounds.bottom() - popup->height() + 1)));
+    popup->move(position);
+    popup->show();
+    if (auto first = popup->findChild<StatusNotifierButton *>())
+        first->setFocus();
+}
