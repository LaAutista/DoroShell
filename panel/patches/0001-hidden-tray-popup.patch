+void LXQtWorldClock::positionPopup()
+{
+    if (mRotatedWidget)
+    {
+        mPopup->setGeometry(calculatePopupWindowPos(mPopup->size()));
+        return;
+    }
+    QRect bounds = mMainWidget->screen()->geometry();
+    QWidget *bar = mMainWidget->window();
+    const int barTop = bar->mapToGlobal(QPoint()).y();
+    if (panel()->position() == ILXQtPanel::PositionBottom)
+        bounds.setBottom(barTop - 1);
+    else
+        bounds.setTop(barTop + bar->height());
+    if (!bounds.isValid())
+        return;
+    mPopup->setMaximumSize(bounds.size());
+    const QSize size = mPopup->sizeHint().boundedTo(bounds.size());
+    QRect target(QPoint(), size);
+    target.moveRight(qBound(bounds.left() + size.width() - 1,
+                            mMainWidget->mapToGlobal(mMainWidget->rect().topRight()).x(), bounds.right()));
+    if (panel()->position() == ILXQtPanel::PositionBottom)
+        target.moveBottom(bounds.bottom());
+    else
+        target.moveTop(bounds.top());
+    mPopup->setGeometry(target);
+}
+
+void LXQtWorldClock::fitClock()
+{
+    if (mMainWidget->height() < 4 || mContent->text().isEmpty())
+        return;
+    QFont font = mMainWidget->font();
+    font.setPixelSize(QFontInfo(font).pixelSize());
+    mContent->setFont(font);
+    while (mContent->sizeHint().height() > mMainWidget->height() - 2 && font.pixelSize() > 1)
+    {
+        font.setPixelSize(font.pixelSize() - 1);
+        mContent->setFont(font);
+    }
+}
