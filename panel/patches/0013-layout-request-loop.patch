diff --git a/plugin-showdesktop/showdesktop.cpp b/plugin-showdesktop/showdesktop.cpp
index 39d1b38..9909a34 100644
--- a/plugin-showdesktop/showdesktop.cpp
+++ b/plugin-showdesktop/showdesktop.cpp
@@ -89,14 +89,17 @@ void ShowDesktop::settingsChanged()
 
 void ShowDesktop::realign()
 {
-    mButton.setMinimumSize(0, 0);
-    mButton.setMaximumSize(QWIDGETSIZE_MAX, QWIDGETSIZE_MAX);
+    // Set the final limits in one step: resetting them first changes the size on every pass,
+    // which posts a LayoutRequest and re-enters realign() forever.
+    QSize min(0, 0), max(QWIDGETSIZE_MAX, QWIDGETSIZE_MAX);
     if (settings()->value(QStringLiteral("doroshellEdge"), false).toBool())
     {
         const int extent = qBound(8, settings()->value(QStringLiteral("doroshellEdgeWidth"), 12).toInt(), 32);
-        if (panel()->isHorizontal()) mButton.setFixedWidth(extent);
-        else mButton.setFixedHeight(extent);
+        if (panel()->isHorizontal()) { min.setWidth(extent); max.setWidth(extent); }
+        else { min.setHeight(extent); max.setHeight(extent); }
     }
+    mButton.setMinimumSize(min);
+    mButton.setMaximumSize(max);
 }
 
 bool ShowDesktop::eventFilter(QObject * watched, QEvent * event)
