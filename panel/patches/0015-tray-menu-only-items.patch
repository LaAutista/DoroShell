--- a/plugin-statusnotifier/statusnotifierbutton.cpp
+++ b/plugin-statusnotifier/statusnotifierbutton.cpp
@@ -29,6 +29,7 @@
 #include "statusnotifierbutton.h"
 
 #include <QDir>
+#include <QXmlStreamReader>
 #include <QFile>
 #include <dbusmenu-lxqt/dbusmenuimporter.h>
 #include "../panel/ilxqtpanelplugin.h"
@@ -88,6 +89,49 @@ StatusNotifierButton::StatusNotifierButton(QString service, QString objectPath,
         }
     });
 
+    // DoroShell: AppIndicator items implement no Activate, so a left click did nothing.
+    // The specification's ItemIsMenu flag is rarely set; the item's own method list is reliable.
+    interface->propertyGetAsync(QLatin1String("ItemIsMenu"), [this] (bool menu) {
+        if (menu)
+            mMenuOnly = true;
+    });
+    connect(new QDBusPendingCallWatcher{QDBusConnection::sessionBus().asyncCall(QDBusMessage::createMethodCall(service, objectPath,
+                QStringLiteral("org.freedesktop.DBus.Introspectable"), QStringLiteral("Introspect"))), this},
+            &QDBusPendingCallWatcher::finished, this, [this] (QDBusPendingCallWatcher *call) {
+        QDBusPendingReply<QString> reply = *call;
+        call->deleteLater();
+        if (reply.isError())
+            return;
+        // Only this interface's own methods count; anything unreadable keeps regular activation.
+        QXmlStreamReader xml(reply.value());
+        bool described = false, activates = false, inside = false;
+        int depth = 0;
+        while (!xml.atEnd())
+        {
+            const auto token = xml.readNext();
+            if (token == QXmlStreamReader::StartElement)
+            {
+                ++depth;
+                const auto name = xml.attributes().value(QLatin1String("name"));
+                if (depth == 2 && xml.name() == QLatin1String("interface"))
+                {
+                    inside = name == QLatin1String("org.kde.StatusNotifierItem");
+                    described = described || inside;
+                }
+                else if (depth == 3 && inside && xml.name() == QLatin1String("method") && name == QLatin1String("Activate"))
+                    activates = true;
+            }
+            else if (token == QXmlStreamReader::EndElement)
+            {
+                if (depth == 2)
+                    inside = false;
+                --depth;
+            }
+        }
+        if (!xml.hasError() && described && !activates)
+            mMenuOnly = true;
+    });
+
     interface->propertyGetAsync(QLatin1String("Status"), [this] (QString status) {
         newStatus(status);
     });
