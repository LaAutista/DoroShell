 #include <QScreen>
 #include <QKeyEvent>
 #include <QDBusMessage>
+#include <QKeySequence>
+#include <LXQtGlobalKeys/Client>
+#include <LXQtGlobalKeys/Action>
 #include <algorithm>
 
 namespace {
+class OverflowPopup : public QFrame
+{
+public:
+    OverflowPopup(QWidget *parent, GlobalKeyShortcut::Action *shortcut, const QString &binding)
+        : QFrame(parent, Qt::Popup), mBinding(sequence(binding))
+    {
+        if (shortcut)
+            connect(shortcut, &GlobalKeyShortcut::Action::shortcutChanged, this,
+                [this](const QString &, const QString &key) { mBinding = sequence(key); });
+    }
+protected:
+    bool eventFilter(QObject *object, QEvent *event) override
+    {
+        if (!mBinding.isEmpty() && (event->type() == QEvent::KeyPress || event->type() == QEvent::ShortcutOverride))
+        {
+            auto key = static_cast<QKeyEvent *>(event);
+            if (mBinding == QKeySequence(key->keyCombination()))
+            {
+                if (event->type() == QEvent::KeyPress && !key->isAutoRepeat())
+                    close();
+                event->accept();
+                return true;
+            }
+        }
+        return QFrame::eventFilter(object, event);
+    }
+private:
+    static QKeySequence sequence(QString key) { return QKeySequence(key.replace(QStringLiteral("Control+"), QStringLiteral("Ctrl+"))); }
+    QKeySequence mBinding;
+};
+
 class OverflowButton : public StatusNotifierButton
