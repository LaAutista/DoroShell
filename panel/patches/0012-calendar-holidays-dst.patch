+// shortcut: US federal holidays on their actual (not observed) dates, en_US-style locales only; add regions or ICS import when requested.
+static QList<QPair<QDate, QString>> doroshellHolidays(int year)
+{
+    QList<QPair<QDate, QString>> days;
+    if (QLocale{}.territory() != QLocale::UnitedStates)
+        return days;
+    const auto nth = [year](int month, int weekday, int n) {
+        const QDate first(year, month, 1);
+        return first.addDays((weekday - first.dayOfWeek() + 7) % 7 + 7 * (n - 1));
+    };
+    const QDate mayEnd(year, 5, 31);
+    const auto add = [&days](QDate date, const char *name) {
+        days.append({date, QCoreApplication::translate("LXQtWorldClock", name)});
+    };
+    add(QDate(year, 1, 1), "New Year's Day");
+    add(nth(1, Qt::Monday, 3), "Martin Luther King Jr. Day");
+    add(nth(2, Qt::Monday, 3), "Washington's Birthday");
+    add(mayEnd.addDays(-(mayEnd.dayOfWeek() - Qt::Monday)), "Memorial Day");
+    add(QDate(year, 6, 19), "Juneteenth");
+    add(QDate(year, 7, 4), "Independence Day");
+    add(nth(9, Qt::Monday, 1), "Labor Day");
+    add(nth(10, Qt::Monday, 2), "Columbus Day");
+    add(QDate(year, 11, 11), "Veterans Day");
+    add(nth(11, Qt::Thursday, 4), "Thanksgiving Day");
+    add(QDate(year, 12, 25), "Christmas Day");
+    return days;
+}
+
+// Mark holidays and the day a daylight-saving transition happens in the clock's zone.
+static void doroshellMarkCalendar(QCalendarWidget *calendar, const QTimeZone &zone, int year, int month)
+{
+    calendar->setDateTextFormat(QDate(), QTextCharFormat());
+    const QDate first = QDate(year, month, 1).addDays(-7);
+    const QDate last = QDate(year, month, 1).addMonths(1).addDays(13);
+    QHash<QDate, QStringList> notes;
+    for (int y = first.year(); y <= last.year(); ++y)
+        for (const auto &holiday : doroshellHolidays(y))
+            if (holiday.first >= first && holiday.first <= last)
+                notes[holiday.first].append(holiday.second);
+    if (zone.isValid() && zone.hasTransitions())
+        for (const auto &t : zone.transitions(first.startOfDay(zone), last.startOfDay(zone)))
+            notes[t.atUtc.toTimeZone(zone).date()].append(t.daylightTimeOffset
+                ? QCoreApplication::translate("LXQtWorldClock", "Daylight saving time begins")
+                : QCoreApplication::translate("LXQtWorldClock", "Daylight saving time ends"));
+    for (auto it = notes.cbegin(); it != notes.cend(); ++it)
+    {
+        QTextCharFormat format;
+        format.setFontWeight(QFont::Bold);
+        format.setFontUnderline(true);
+        format.setToolTip(it.value().join(QLatin1Char('\n')));
+        calendar->setDateTextFormat(it.key(), format);
+    }
+}
